# ===== 环境 =====
# local / test / staging / production
APP_ENV=local

# ===== LLM =====
# provider: 空自动判断；"mock" 强制 Mock；非 local 环境必须显式 MOCK_MODE=true 才允许 Mock
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.4

# ===== 鉴权 (JWT) =====
JWT_SECRET=please-change-me-in-production
JWT_ISSUER=devops-mindagent
JWT_EXPIRE_SECONDS=3600
# 内置种子用户，JSON 数组
# SEED_USERS=[{"tenant_id":"tenant-a","username":"demo","password":"demo1234","roles":["developer"],"permissions":["chat:use","history:read","history:delete","tool:logs:read","tool:redis:read","trace:read","kb:manage"]}]

# ===== 持久化 (MySQL 8.0 / SQLite 本地默认) =====
# DATABASE_URL=mysql+pymysql://mindagent:mindagent@127.0.0.1:3306/mindagent
# DATABASE_URL=sqlite:///./data/dev.db
DB_AUTO_CREATE=true

# ===== Redis (可选，缺省自动降级为进程内内存存储) =====
REDIS_URL=
REDIS_RATE_SCRIPT=true

# ===== RAG =====
# vector store: local / chroma / chroma-http
VECTOR_STORE=local
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=mindagent_kb
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_TOP_K=3
RAG_BM25_WEIGHT=0.35
RAG_VECTOR_WEIGHT=0.65

# ===== 语义缓存 =====
SEMANTIC_CACHE=true
SEMANTIC_THRESHOLD=0.95
SEMANTIC_TTL=600

# ===== 会话 / 限流 =====
SESSION_TTL=86400
RATE_RATE=2.0
RATE_CAP=10

# ===== Kafka 审计 =====
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TRACE_TOPIC=mindagent.agent.trace.v1
KAFKA_TOOL_TOPIC=mindagent.tool.call.v1
KAFKA_SECURITY_TOPIC=mindagent.security.audit.v1
KAFKA_GROUP_ID=mindagent-audit-consumer

# ===== 工具适配器 (真实数据源) =====
LOG_PLATFORM_URL=
REDIS_DIAG_URL=
TOOL_TIMEOUT=5.0

# ===== 安全边界 =====
MAX_INPUT_LEN=4096
MAX_TOOL_OUTPUT=4000
MAX_LOG_RANGE_MINUTES=1440
MAX_LOG_LIMIT=200